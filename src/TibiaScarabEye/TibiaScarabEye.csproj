<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TibiaScarabEye</RootNamespace>
    <AssemblyName>TibiaScarabEye</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Tibia Scarab Eye</Product>
    <Company>augustcaio</Company>
    <Copyright>Copyright (c) 2026 augustcaio. Todos os direitos reservados.</Copyright>
    <!-- A publicacao autocontida traz textos do .NET em dezenas de idiomas; o programa so usa o ingles do runtime. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Gera ApplicationConfiguration.Initialize(). SystemAware: DPI do sistema, nao por monitor. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="Assets\emblem.png" LogicalName="emblem.png" />
    <EmbeddedResource Include="Assets\thorns.png" LogicalName="thorns.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TibiaScarabEye.Tests" />
  </ItemGroup>

</Project>
