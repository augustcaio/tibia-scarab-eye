<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TibiaScarabEye</RootNamespace>
    <AssemblyName>TibiaScarabEye</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Product>Tibia Scarab Eye</Product>
    <Company>augustcaio</Company>
    <Copyright>Copyright (c) 2026 augustcaio. Todos os direitos reservados.</Copyright>
    <!-- A publicacao autocontida traz textos do .NET em dezenas de idiomas; o programa so usa o ingles do runtime. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Gera ApplicationConfiguration.Initialize(). SystemAware: DPI do sistema, nao por monitor. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sprites do Collar e do Ring of Red Plasma: aparecem na janela e são o que o programa procura nas áreas recortadas. -->
    <EmbeddedResource Include="Assets\Sprites\*.gif" LogicalName="Sprites.%(Filename)%(Extension)" />
    <!-- Sons dos alertas (WAV do jogador) e o guia de nomes; vão para a pasta sounds ao lado do executável. -->
    <Content Include="Assets\Sounds\*" Link="sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TibiaScarabEye.Tests" />
  </ItemGroup>

</Project>
