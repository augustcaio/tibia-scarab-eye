<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TibiaScarabEye</RootNamespace>
    <AssemblyName>TibiaScarabEye</AssemblyName>
    <!-- Gera ApplicationConfiguration.Initialize(). SystemAware: DPI do sistema, nao por monitor. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TibiaScarabEye.Tests" />
  </ItemGroup>

</Project>
